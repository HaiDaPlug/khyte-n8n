{
  "name": "Audit Log",
  "nodes": [
    {
      "parameters": {},
      "name": "When Called",
      "type": "n8n-nodes-base.manualTrigger",
      "typeVersion": 1,
      "position": [250, 300]
    },
    {
      "parameters": {
        "values": {
          "string": [
            {
              "name": "workflowName",
              "value": "={{ $json.workflowName }}"
            },
            {
              "name": "eventType",
              "value": "={{ $json.eventType }}"
            },
            {
              "name": "payloadSummary",
              "value": "={{ $json.payloadSummary || '' }}"
            },
            {
              "name": "timestamp",
              "value": "={{ $json.timestamp || $now.toISO() }}"
            },
            {
              "name": "environment",
              "value": "={{ $env.ENVIRONMENT || 'production' }}"
            }
          ],
          "object": [
            {
              "name": "details",
              "value": "={{ $json.details || {} }}"
            }
          ]
        }
      },
      "name": "Set Input Parameters",
      "type": "n8n-nodes-base.set",
      "typeVersion": 2,
      "position": [450, 300]
    },
    {
      "parameters": {
        "functionCode": "const { workflowName, eventType, payloadSummary, details, timestamp, environment } = $input.item.json;\n\nreturn {\n  timestamp,\n  workflowName,\n  eventType,\n  payloadSummary,\n  details: JSON.stringify(details),\n  environment,\n  loggedBy: 'n8n-automation',\n  executionId: process.env.N8N_EXECUTION_ID || 'unknown'\n};"
      },
      "name": "Build Log Entry",
      "type": "n8n-nodes-base.function",
      "typeVersion": 1,
      "position": [650, 300]
    },
    {
      "parameters": {
        "operation": "append",
        "sheetId": "={{ $env.AUDIT_LOG_SHEET_ID }}",
        "range": "Sheet1",
        "options": {
          "valueInputMode": "USER_ENTERED"
        },
        "columns": {
          "mappings": [
            {
              "column": "timestamp",
              "value": "={{ $json.timestamp }}"
            },
            {
              "column": "workflowName",
              "value": "={{ $json.workflowName }}"
            },
            {
              "column": "eventType",
              "value": "={{ $json.eventType }}"
            },
            {
              "column": "payloadSummary",
              "value": "={{ $json.payloadSummary }}"
            },
            {
              "column": "details",
              "value": "={{ $json.details }}"
            },
            {
              "column": "environment",
              "value": "={{ $json.environment }}"
            },
            {
              "column": "loggedBy",
              "value": "={{ $json.loggedBy }}"
            },
            {
              "column": "executionId",
              "value": "={{ $json.executionId }}"
            }
          ]
        }
      },
      "name": "Write to Google Sheets",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4,
      "position": [850, 300],
      "continueOnFail": true,
      "credentials": {
        "googleSheetsOAuth2Api": {
          "id": "1",
          "name": "Google Sheets Account"
        }
      }
    },
    {
      "parameters": {
        "conditions": {
          "boolean": [
            {
              "value1": "={{ $json.error === undefined }}",
              "value2": true
            }
          ]
        }
      },
      "name": "Check Write Success",
      "type": "n8n-nodes-base.if",
      "typeVersion": 1,
      "position": [1050, 300]
    },
    {
      "parameters": {
        "functionCode": "return {\n  logged: true,\n  logId: `row-${Date.now()}`,\n  destination: 'google-sheets',\n  timestamp: $('Build Log Entry').item.json.timestamp\n};"
      },
      "name": "Return Success",
      "type": "n8n-nodes-base.function",
      "typeVersion": 1,
      "position": [1250, 200]
    },
    {
      "parameters": {
        "functionCode": "return {\n  logged: false,\n  error: $input.item.json.error || 'Unknown error writing to audit log',\n  destination: 'google-sheets',\n  timestamp: $('Build Log Entry').item.json.timestamp\n};"
      },
      "name": "Return Failure",
      "type": "n8n-nodes-base.function",
      "typeVersion": 1,
      "position": [1250, 400]
    }
  ],
  "connections": {
    "When Called": {
      "main": [
        [
          {
            "node": "Set Input Parameters",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Set Input Parameters": {
      "main": [
        [
          {
            "node": "Build Log Entry",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Build Log Entry": {
      "main": [
        [
          {
            "node": "Write to Google Sheets",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Write to Google Sheets": {
      "main": [
        [
          {
            "node": "Check Write Success",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Check Write Success": {
      "main": [
        [
          {
            "node": "Return Success",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Return Failure",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "active": false,
  "settings": {},
  "versionId": "1",
  "id": "audit-log-subflow",
  "meta": {
    "instanceId": "khyte-n8n-subflow"
  },
  "tags": []
}
