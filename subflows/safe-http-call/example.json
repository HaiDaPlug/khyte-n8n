{
  "name": "SafeHTTP: Make API Call",
  "nodes": [
    {
      "parameters": {},
      "name": "When Called",
      "type": "n8n-nodes-base.manualTrigger",
      "typeVersion": 1,
      "position": [250, 300]
    },
    {
      "parameters": {
        "values": {
          "string": [
            {
              "name": "url",
              "value": "={{ $json.url }}"
            },
            {
              "name": "method",
              "value": "={{ $json.method || 'GET' }}"
            }
          ],
          "number": [
            {
              "name": "maxRetries",
              "value": "={{ $json.maxRetries || 3 }}"
            },
            {
              "name": "backoffFactor",
              "value": "={{ $json.backoffFactor || 2 }}"
            },
            {
              "name": "timeoutMs",
              "value": "={{ $json.timeoutMs || 30000 }}"
            },
            {
              "name": "currentAttempt",
              "value": 0
            }
          ],
          "object": [
            {
              "name": "headers",
              "value": "={{ $json.headers || {} }}"
            },
            {
              "name": "body",
              "value": "={{ $json.body || null }}"
            }
          ]
        },
        "options": {}
      },
      "name": "Set Input Parameters",
      "type": "n8n-nodes-base.set",
      "typeVersion": 2,
      "position": [450, 300]
    },
    {
      "parameters": {
        "functionCode": "const config = {\n  url: $input.item.json.url,\n  method: $input.item.json.method,\n  headers: $input.item.json.headers,\n  timeout: $input.item.json.timeoutMs,\n  maxRetries: $input.item.json.maxRetries,\n  backoffFactor: $input.item.json.backoffFactor,\n  currentAttempt: $input.item.json.currentAttempt\n};\n\nif ($input.item.json.body && $input.item.json.body !== null) {\n  config.body = $input.item.json.body;\n}\n\nreturn config;"
      },
      "name": "Build Request",
      "type": "n8n-nodes-base.function",
      "typeVersion": 1,
      "position": [650, 300]
    },
    {
      "parameters": {
        "method": "={{ $json.method }}",
        "url": "={{ $json.url }}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": "={{ $json.headers }}"
        },
        "sendBody": true,
        "bodyParameters": {
          "parameters": "={{ $json.body }}"
        },
        "options": {
          "timeout": "={{ $json.timeout }}",
          "redirect": {
            "redirect": {
              "followRedirects": true,
              "maxRedirects": 5
            }
          }
        }
      },
      "name": "Execute HTTP Request",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4,
      "position": [850, 300],
      "continueOnFail": true
    },
    {
      "parameters": {
        "conditions": {
          "boolean": [
            {
              "value1": "={{ $json.statusCode >= 200 && $json.statusCode < 400 }}",
              "value2": true
            }
          ]
        }
      },
      "name": "Check Response Status",
      "type": "n8n-nodes-base.if",
      "typeVersion": 1,
      "position": [1050, 300]
    },
    {
      "parameters": {
        "functionCode": "return {\n  success: true,\n  statusCode: $input.item.json.statusCode || 200,\n  data: $input.item.json.body || $input.item.json,\n  headers: $input.item.json.headers || {}\n};"
      },
      "name": "Normalize Success Response",
      "type": "n8n-nodes-base.function",
      "typeVersion": 1,
      "position": [1250, 200]
    },
    {
      "parameters": {
        "functionCode": "const statusCode = $input.item.json.statusCode;\nconst currentAttempt = $('Build Request').item.json.currentAttempt || 0;\nconst maxRetries = $('Build Request').item.json.maxRetries || 3;\n\n// Check if error is retryable\nconst isNetworkError = !statusCode; // No status code = network error\nconst isServerError = statusCode >= 500;\nconst isRateLimitError = statusCode === 429;\nconst shouldRetry = (isNetworkError || isServerError || isRateLimitError) && currentAttempt < maxRetries;\n\nconst errorType = isNetworkError ? 'NetworkError' :\n           isServerError ? 'ServerError' :\n           isRateLimitError ? 'RateLimitError' :\n           'ClientError';\n\nreturn {\n  shouldRetry,\n  currentAttempt,\n  maxRetries,\n  statusCode: statusCode || 0,\n  errorType,\n  responseBody: $input.item.json.body || $input.item.json,\n  originalRequest: $('Build Request').item.json\n};"
      },
      "name": "Check If Should Retry",
      "type": "n8n-nodes-base.function",
      "typeVersion": 1,
      "position": [1250, 400]
    },
    {
      "parameters": {
        "conditions": {
          "boolean": [
            {
              "value1": "={{ $json.shouldRetry }}",
              "value2": true
            }
          ]
        }
      },
      "name": "Should Retry?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 1,
      "position": [1450, 400]
    },
    {
      "parameters": {
        "functionCode": "const backoffFactor = $input.item.json.originalRequest.backoffFactor || 2;\nconst currentAttempt = $input.item.json.currentAttempt || 0;\nconst waitSeconds = Math.pow(backoffFactor, currentAttempt + 1);\n\nreturn {\n  waitSeconds,\n  nextAttempt: currentAttempt + 1,\n  originalRequest: $input.item.json.originalRequest\n};"
      },
      "name": "Calculate Backoff",
      "type": "n8n-nodes-base.function",
      "typeVersion": 1,
      "position": [1650, 300]
    },
    {
      "parameters": {
        "amount": "={{ $json.waitSeconds }}",
        "unit": "seconds"
      },
      "name": "Wait Before Retry",
      "type": "n8n-nodes-base.wait",
      "typeVersion": 1,
      "position": [1850, 300]
    },
    {
      "parameters": {
        "values": {
          "string": [
            {
              "name": "url",
              "value": "={{ $json.originalRequest.url }}"
            },
            {
              "name": "method",
              "value": "={{ $json.originalRequest.method }}"
            }
          ],
          "number": [
            {
              "name": "currentAttempt",
              "value": "={{ $json.nextAttempt }}"
            },
            {
              "name": "maxRetries",
              "value": "={{ $json.originalRequest.maxRetries }}"
            },
            {
              "name": "backoffFactor",
              "value": "={{ $json.originalRequest.backoffFactor }}"
            },
            {
              "name": "timeoutMs",
              "value": "={{ $json.originalRequest.timeout }}"
            }
          ],
          "object": [
            {
              "name": "headers",
              "value": "={{ $json.originalRequest.headers }}"
            },
            {
              "name": "body",
              "value": "={{ $json.originalRequest.body }}"
            }
          ]
        }
      },
      "name": "Prepare Retry",
      "type": "n8n-nodes-base.set",
      "typeVersion": 2,
      "position": [2050, 300]
    },
    {
      "parameters": {
        "functionCode": "const errorType = $input.item.json.errorType || 'UnknownError';\nconst statusCode = $input.item.json.statusCode || 0;\nconst attemptsMade = $input.item.json.currentAttempt + 1 || 1;\n\nlet message = 'Request failed';\nif (errorType === 'NetworkError') {\n  message = 'Network error: unable to reach the server';\n} else if (errorType === 'ServerError') {\n  message = `Server error: ${statusCode}`;\n} else if (errorType === 'RateLimitError') {\n  message = 'Rate limit exceeded (429)';\n} else if (errorType === 'ClientError') {\n  message = `Client error: ${statusCode}`;\n}\n\nreturn {\n  success: false,\n  error: {\n    type: errorType,\n    message,\n    statusCode,\n    responseBody: $input.item.json.responseBody,\n    attemptsMade\n  }\n};"
      },
      "name": "Normalize Error Response",
      "type": "n8n-nodes-base.function",
      "typeVersion": 1,
      "position": [1650, 500]
    }
  ],
  "connections": {
    "When Called": {
      "main": [
        [
          {
            "node": "Set Input Parameters",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Set Input Parameters": {
      "main": [
        [
          {
            "node": "Build Request",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Build Request": {
      "main": [
        [
          {
            "node": "Execute HTTP Request",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Execute HTTP Request": {
      "main": [
        [
          {
            "node": "Check Response Status",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Check Response Status": {
      "main": [
        [
          {
            "node": "Normalize Success Response",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Check If Should Retry",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Check If Should Retry": {
      "main": [
        [
          {
            "node": "Should Retry?",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Should Retry?": {
      "main": [
        [
          {
            "node": "Calculate Backoff",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Normalize Error Response",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Calculate Backoff": {
      "main": [
        [
          {
            "node": "Wait Before Retry",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Wait Before Retry": {
      "main": [
        [
          {
            "node": "Prepare Retry",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Prepare Retry": {
      "main": [
        [
          {
            "node": "Build Request",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "active": false,
  "settings": {},
  "versionId": "1",
  "id": "safe-http-call-subflow",
  "meta": {
    "instanceId": "khyte-n8n-subflow"
  },
  "tags": []
}
